{
  "expo": {
    "name": "Edunesis",
    "slug": "edunesis",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/edunesis-logo.jpg",
    "assetBundlePatterns": ["**/*"],
    "platforms": ["ios", "android", "web"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.edublox"
    },
    "android": {
      "package": "com.anonymous.edublox",
      "adaptiveIcon": {
        "foregroundImage": "./assets/edunesis-logo.jpg",
        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/edunesis-logo.jpg"
    }
  }
}
